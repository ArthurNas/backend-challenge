{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "start": "bun dist/main.js",
    "start:dev": "bun --watch src/main.ts",
    "worker": "bun src/worker-main.ts",
    "worker:prod": "bun dist/worker-main.js",
    "queue:send": "bun scripts/send-wager.ts",
    "test:containers": "docker compose --profile test run --build --rm tests",
    "test:async": "bun scripts/test-async.ts",
    "test": "bun test",
    "test:unit": "bun test test/domain.test.ts test/events.test.ts test/database-errors.test.ts",
    "test:integration": "bun scripts/test-integration.ts",
    "db:migrate": "bun scripts/migrate.ts up",
    "db:rollback": "bun scripts/migrate.ts down",
    "format": "prettier --write src test scripts package.json tsconfig*.json .prettierrc.json",
    "format:check": "prettier --check src test scripts package.json tsconfig*.json .prettierrc.json",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1167.0",
    "@mikro-orm/core": "6",
    "@mikro-orm/migrations": "6",
    "@mikro-orm/postgresql": "6",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "prettier": "3",
    "typescript": "^5.9.0"
  }
}
